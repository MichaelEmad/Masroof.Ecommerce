{
  "App": {
    "SelfUrl": "https://api.masroof.com",
    "ClientUrl": "https://masroof.com",
    "CorsOrigins": "https://masroof.com,https://www.masroof.com",
    "RedirectAllowedUrls": "https://masroof.com",
    "ShowPII": "false"
  },
  "ConnectionStrings": {
    "Default": "Server=YOUR_SERVER;Database=Masroof_Production;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Payment": {
    "Stripe": {
      "PublishableKey": "pk_live_YOUR_LIVE_KEY",
      "SecretKey": "sk_live_YOUR_LIVE_KEY",
      "WebhookSecret": "whsec_YOUR_WEBHOOK_SECRET",
      "PaymentMethodTypes": ["card"]
    }
  },
  "Settings": {
    "Abp.Mailing.Smtp.Host": "smtp.gmail.com",
    "Abp.Mailing.Smtp.Port": "587",
    "Abp.Mailing.Smtp.UserName": "noreply@masroof.com",
    "Abp.Mailing.Smtp.Password": "YOUR_APP_PASSWORD",
    "Abp.Mailing.Smtp.EnableSsl": "true",
    "Abp.Mailing.DefaultFromAddress": "noreply@masroof.com",
    "Abp.Mailing.DefaultFromDisplayName": "Masroof E-Commerce"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
